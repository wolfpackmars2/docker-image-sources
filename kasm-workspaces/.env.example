# Copy this file to .env and fill in your values.
# .env is git-ignored and will not be committed.

# Docker Hub username — used as the registry prefix for all image names
# e.g. "myusername" produces images like myusername/kasm-calibre
REGISTRY="your-dockerhub-username"

# KASM host for loading dev images during testing (--dev / --load)
# Format: user@hostname
KASM_HOST="user@your-kasm-host.example.com"
